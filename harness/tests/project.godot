; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Godot-JVM Tests"
run/main_scene="uid://cnqp52df0ln8e"
config/features=PackedStringArray("4.7")
config/icon="res://icon.png"
run/main_loop_type.export-tests="ExportTestMain"
run/main_loop_type.export-graal-native-image="ExportTestMain"

[autoload]

KotlinScriptSingleton="*res://src/main/kotlin/godot/tests/runtime/KotlinScriptAutoload.kt"
KotlinSceneSingleton="*res://test/runtime/fixtures/kotlin_scene_autoload.tscn"

[debug]

settings/stdout/verbose_stdout=true

[editor_plugins]

enabled=PackedStringArray("res://addons/gdUnit4/plugin.cfg")

[gdunit4]

settings/test/test_suite_naming_convention=1
settings/test/test_discovery=true
ui/toolbar/run_overall=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/default_environment="res://default_env.tres"
