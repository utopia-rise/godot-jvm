<idea-plugin require-restart="false">
    <id>com.utopia-rise.godotjvmideaplugin</id>
    <name>Godot-JVM</name>
    <vendor url="https://github.com/utopia-rise/" email="meisels27@yahoo.fr">Utopia-Rise</vendor>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <projectService serviceImplementation="godot.intellij.plugin.GodotJvmProjectService"/>
        <projectService serviceImplementation="godot.intellij.plugin.GodotProjectScopeService"/>
        <projectService serviceImplementation="godot.intellij.plugin.registration.RegistrationSettings"/>
        <projectConfigurable
                id="godot.kotlin.jvm.settings"
                displayName="Godot-JVM"
                instance="godot.intellij.plugin.registration.RegistrationSettingsConfigurable"/>
        <postStartupActivity implementation="godot.intellij.plugin.GodotJvmProjectActivity"/>
        <newProjectWizard.generator implementation="godot.intellij.plugin.wizard.GodotNewProjectWizard"/>
        <configurationType implementation="godot.intellij.plugin.run.GodotRunConfigurationType"/>
        <notificationGroup id="Error message" displayType="STICKY_BALLOON" key="notification.group.error" isLogByDefault="true"/>
        <localInspection implementationClass="godot.intellij.plugin.inspection.JavaInspection" language="JAVA"/>
        <localInspection implementationClass="godot.intellij.plugin.inspection.KotlinInspection" language="kotlin"/>
        <localInspection implementationClass="godot.intellij.plugin.inspection.CoreTypeCopyModificationInspection" language="kotlin"/>
        <annotator implementationClass="godot.intellij.plugin.highlighting.RegistrationHighlightAnnotator" language="JAVA"/>
        <annotator implementationClass="godot.intellij.plugin.highlighting.RegistrationHighlightAnnotator" language="kotlin"/>
    </extensions>

    <extensions defaultExtensionNs="org.jetbrains.kotlin">
        <supportsKotlinPluginMode supportsK2="true"/>
    </extensions>

    <actions>
        <action id="godot.jvm.newScript"
                class="godot.intellij.plugin.action.NewGodotScriptAction"
                icon="/pluginIcon_small.svg">
            <add-to-group group-id="NewGroup" anchor="first"/>
        </action>
    </actions>

    <resource-bundle>messages.generalLabels</resource-bundle>

    <depends>com.intellij.java</depends>
    <depends>org.jetbrains.kotlin</depends>
    <depends optional="true" config-file="godotjvmideaplugin-with-scala.xml">org.intellij.scala</depends>
</idea-plugin>
